# Local MCP config (contains tokens)
.mcp.json
.deepseek/mcp.json

# YOLO stores OAuth credentials (ChatGPT/Gemini/Copilot/MCP) under
# .obsidian/plugins/<manifest id>/, which differs from the plugin folder
.obsidian/plugins/yolo-xox/
.obsidian/plugins/yolo/

# Obsidian per-machine config (theme, enabled plugins, workspace).
# Plugin source stays tracked: .obsidian/plugins/obsidian-yolo/
.obsidian/*
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-yolo/

# YOLO chat history (private, stays on this machine)
YOLO/data/chats/
epub/
epub/*.txt

# 网易云听歌记录（私人数据）
兴趣/网易云·每日听歌/plays.jsonl
兴趣/网易云·每日听歌/last_error.txt

# 节点分享链接（私人，不进 Git）
私人/

# claude.ai 数据导出原件（含邮箱、手机号、登录 IP，私人）
claude_data-*/
